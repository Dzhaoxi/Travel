/* pages/spot/spot.wxss */

.spot-banner {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  background: #f0f0f0;
}

.spot-banner-placeholder {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #1aad19, #4cd964);
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 60rpx;
  color: #fff;
  font-weight: 600;
  text-align: center;
  padding: 0 32rpx;
}

.spot-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.spot-name {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
  margin-right: 16rpx;
}

.fav-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f8f8f8;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}

.fav-btn-active {
  background: #fff7e6;
  border-color: #ff9500;
  color: #ff9500;
}

.fav-icon {
  font-size: 32rpx;
  color: #ff9500;
}

.fav-text {
  font-size: 26rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-bar-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.action-bar-primary {
  background: #1aad19;
  color: #fff;
}

.action-bar-secondary {
  background: #fff;
  color: #ff9500;
  border: 2rpx solid #ff9500;
}
